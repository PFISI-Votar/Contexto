%% ============================================================================
%% DIAGRAMA DE CLASES — Plataforma VOTAR (Modelo de Análisis)
%% Proyecto Final de Ingeniería en Sistemas de Información
%% UTN FRVM — Equipo 09 — Sprint 2
%% ============================================================================
%% Evolución respecto a Sprint 1:
%% - US-330/331: importación CSV, hojas anonimizadas (hash Keccak-256), novedades
%% - VOTAR-334: consolidación criptográfica del padrón (MerkleTree, proofs on-demand)
%% - US-335: publicación on-chain del sello Merkle (AlmacenRaizMerkle)
%% - VOTAR-354: solicitud autenticada de MerkleProof por votante (on-demand, sin persistir)
%% - VOTAR-339: validación on-chain de electores en BallotContract (InvalidMerkleProof)
%% ============================================================================

classDiagram

    %% ── Enumeraciones de dominio ───────────────────────────────────────────
    class EleccionEstado {
        <<enumeration>>
        BORRADOR
        CONFIGURADA
        ABIERTA
        CERRADA
        ESCRUTADA
    }

    class TipoVotacion {
        <<enumeration>>
        POR_CANDIDATO
        POR_LISTA
        MIXTO
    }

    class MetodoAutenticacion {
        <<enumeration>>
        GOOGLE
        SSO_INSTITUCIONAL
    }

    class PoliticaRevoto {
        <<enumeration>>
        LAST_VOTE_WINS
        DISABLED
    }

    class MerkleTreeEstado {
        <<enumeration>>
        GENERADO
        ACTIVO
        PUBLICADO_ON_CHAIN
        OBSOLETO
    }

    class PadronEstado {
        <<enumeration>>
        BORRADOR
        PUBLICADO
        CERRADO
    }

    class TipoNovedad {
        <<enumeration>>
        DNI_AUSENTE
        EMAIL_AUSENTE
        DNI_INVALIDO
        EMAIL_INVALIDO
        DUPLICADO
    }

    %% ── Value objects ──────────────────────────────────────────────────────
    class Hash {
        <<value object>>
        -String valor
        +validarFormatoKeccak256() boolean
        +toBytes32Hex() String
    }

    class MerkleProof {
        <<value object>>
        -String[] hashesHermanos
        +verificarConRaiz(root Hash, leaf Hash) boolean
    }

    class ValidacionCampo {
        <<value object>>
        -Integer minLength
        -Integer maxLength
        -Double minValor
        -Double maxValor
        -String pattern
        -String patternMessage
    }

    class ViolacionMinimoCandidatos {
        <<value object>>
        -String nombreLista
        -String nombreCategoria
        -int minimoRequerido
        -int cantidadActual
        -int faltantes
    }

    class ResultadoValidacionMinimos {
        <<value object>>
        -boolean valido
        -ViolacionMinimoCandidatos[] violaciones
    }

    class NovedadPadron {
        <<value object>>
        -int linea
        -TipoNovedad tipo
        -String motivo
    }

    class PublicacionMerkle {
        <<value object>>
        -Hash raizPublicada
        -Hash hashTransaccion
        -int numeroBloque
        -DateTime fechaPublicacion
    }

    %% ── Núcleo del comicio ───────────────────────────────────────────────
    class Eleccion {
        -int idEleccion
        -String nombre
        -String descripcion
        -DateTime fechaInicio
        -DateTime fechaFin
        -EleccionEstado estado
        -TipoVotacion tipoVotacion
        -DateTime fechaCreacion
        -DateTime fechaActualizacion
        +inicializarEnBorrador() void
        +validarVentanaTemporal() boolean
        +estaEnBorrador() boolean
        +abrirVotacion() void
        +cerrarVotacion() void
        +oficializarOferta() void
    }

    class ConfiguracionComicio {
        -int idConfiguracion
        -boolean permitirVotoEnBlanco
        -boolean permitirVotoMultiple
        -int maxVotosPorVotante
        -int minIntervaloSegundos
        -boolean mostrarResultadosTiempoReal
        -Integer duracionMinutos
        -MetodoAutenticacion[] metodosAutenticacion
        -PoliticaRevoto politicaRevoto
        +definirMetodosAutenticacion(metodos MetodoAutenticacion[]) void
        +validarMetodosAutenticacion() boolean
        +validarConfiguracion() boolean
    }

    class AutoridadElectoral {
        -int idAutoridad
        -String nombre
        -String email
        -String rol
        +crearComicio(eleccion Eleccion) Eleccion
        +configurarAccesoVotantes(config ConfiguracionComicio) void
        +definirRolesPostulacion(categorias Categoria[]) void
        +gestionarOfertaElectoral(eleccion Eleccion) void
        +importarPadron(eleccion Eleccion, archivo String) PadronElectoral
        +publicarSelloMerkle(eleccion Eleccion) PublicacionMerkle
    }

    class Votante {
        -String emailInstitucional
        +autenticarInstitucional() boolean
        +solicitarProofPadron(eleccion Eleccion) MerkleProof
    }

    %% ── Oferta electoral ─────────────────────────────────────────────────
    class Boleta {
        -int idBoleta
        -String titulo
        -DateTime fechaPublicacion
        -String estado
        +crearParaEleccion(eleccion Eleccion) Boleta
        +agregarRol(categoria Categoria) void
        +agregarLista(lista Lista) void
        +obtenerListas() List
        +obtenerCategorias() List
        +publicar() void
    }

    class Categoria {
        -int idCategoria
        -String nombre
        -String descripcion
        -int cantidadCargos
        -int minimoPostulantes
        -int orden
        +definirRol(nombre String, minPostulantes int, maxPostulantes int) void
        +obtenerCandidatos() List
        +validarCupoPostulantes(cantidadActual int) boolean
    }

    class Lista {
        -int idLista
        -String nombre
        -String sigla
        -String color
        -DateTime fechaOficializacion
        -String estado
        -Integer listId
        +agregarCandidato(candidato Candidato) void
        +contarCandidatosPorCategoria(categoria Categoria) int
        +cumpleMinimosCandidatos(categorias Categoria[]) ResultadoValidacionMinimos
        +oficializar() void
        +obtenerCandidatos() List
        +estaOficializada() boolean
    }

    class Candidato {
        -int idCandidato
        -String nombre
        -String apellido
        -int orden
        -String fotoUrl
        -Map datosAdicionales
        +registrarEnLista(lista Lista, categoria Categoria) void
        +completarDatosAdicionales(datos Map) void
        +validarDatosContraConfiguracion(config ConfiguracionDatosCandidato) boolean
    }

    class ConfiguracionDatosCandidato {
        -int idConfiguracion
        -DateTime fechaCreacion
        -DateTime fechaActualizacion
        +agregarCampo(campo CampoDatosCandidato) void
        +obtenerCampos() List
        +validarDatosCandidato(datos Map) boolean
    }

    class CampoDatosCandidato {
        -int idCampo
        -String clave
        -String etiqueta
        -String tipo
        -boolean obligatorio
        -int orden
        +esObligatorio() boolean
        +validarValor(valor String) boolean
    }

    %% ── Padrón y consolidación criptográfica (VOTAR-334 / US-335) ────────
    class PadronElectoral {
        -int idPadron
        -int totalVotantesHabilitados
        -Hash hashPadron
        -PadronEstado estado
        -int totalProcesados
        -int totalOmitidos
        -DateTime fechaGeneracion
        +importarHojasAnonimizadas(archivo String) void
        +consolidarMerkleTree() MerkleTree
        +obtenerTotalHabilitados() int
        +publicarSelloOnChain() PublicacionMerkle
        +registrarNovedades(novedades NovedadPadron[]) void
    }

    class PadronVotante {
        -UUID idPadronVotante
        -int indiceHoja
        -Hash hashHoja
        -DateTime generadoEn
    }

    class MerkleTree {
        -int idMerkleTree
        -Hash merkleRoot
        -int totalHojas
        -int version
        -MerkleTreeEstado estado
        -DateTime fechaGeneracion
        +generarProof(indiceHoja int) MerkleProof
        +generarProofParaHash(hashHoja Hash) MerkleProof
        +verificarProof(proof MerkleProof, hashHoja Hash) boolean
        +obtenerRaiz() Hash
        +estaPublicadoOnChain() boolean
    }

    class AlmacenRaizMerkle {
        <<contrato inteligente>>
        -Hash raizVigente
        -DateTime fechaUltimaPublicacion
        +publicarRaiz(eleccion Eleccion, raiz Hash) PublicacionMerkle
        +consultarRaiz(eleccion Eleccion) Hash
    }

    class ContratoBoleta {
        <<contrato inteligente>>
        +castVote(eleccionId int, hojaVotante Hash, proof MerkleProof) void
        +haVotado(eleccionId int, hojaVotante Hash) boolean
        -verificarMerkleProof(eleccionId int, hojaVotante Hash, proof MerkleProof) void
    }

    %% ── Composición y asociaciones ───────────────────────────────────────
    Eleccion "1" *-- "1" ConfiguracionComicio : configura
    Eleccion "1" *-- "1" Boleta : publica
    Eleccion "1" *-- "0..1" ConfiguracionDatosCandidato : define campos
    Eleccion "1" *-- "0..1" PadronElectoral : habilita

    Boleta "1" *-- "1..*" Categoria : organiza roles
    Boleta "1" *-- "0..*" Lista : contiene
    Lista "1" *-- "0..*" Candidato : compone
    Categoria "1" -- "0..*" Candidato : clasifica
    ConfiguracionDatosCandidato "1" *-- "0..*" CampoDatosCandidato : compone
    CampoDatosCandidato "1" *-- "0..1" ValidacionCampo : restringe
    ResultadoValidacionMinimos "1" *-- "0..*" ViolacionMinimoCandidatos : detalla

    PadronElectoral "1" *-- "1" MerkleTree : consolida
    PadronElectoral "1" *-- "1..*" PadronVotante : incluye hojas
    PadronElectoral "1" *-- "0..*" NovedadPadron : reporta

    AutoridadElectoral "1..*" --> "1..*" Eleccion : administra
    AutoridadElectoral "1..*" --> "0..*" PadronElectoral : gestiona
    AutoridadElectoral ..> AlmacenRaizMerkle : publica sello

    Votante ..> MerkleTree : acredita pertenencia via proof
    Votante ..> MerkleProof : solicita on-demand
    Votante ..> ContratoBoleta : emite sufragio con proof
    MerkleTree ..> MerkleProof : genera on-demand
    MerkleTree ..> AlmacenRaizMerkle : ancla raíz
    ContratoBoleta ..> AlmacenRaizMerkle : consulta raíz vigente
    ContratoBoleta ..> MerkleProof : verifica on-chain
    PadronElectoral ..> PublicacionMerkle : registra publicación

    Lista ..> ResultadoValidacionMinimos : evalúa cupos
    Categoria ..> ResultadoValidacionMinimos : define mínimos
    Eleccion --> EleccionEstado : estado
    Eleccion --> TipoVotacion : modalidad
    ConfiguracionComicio --> MetodoAutenticacion : acceso votantes
    ConfiguracionComicio --> PoliticaRevoto : revoto
    MerkleTree --> MerkleTreeEstado : estado
    PadronElectoral --> PadronEstado : estado
    NovedadPadron --> TipoNovedad : tipo
    PadronVotante --> Hash : hash_hoja
    MerkleTree --> Hash : merkle_root
    PadronElectoral --> Hash : hash_padron

    note for Eleccion "US-316: inicializarEnBorrador() crea el proceso\nen capa relacional sin despliegue blockchain.\nUS-319: oficializarOferta() bloqueada si alguna\nlista no alcanza minimoPostulantes por categoría."
    note for PadronVotante "US-330: solo hash Keccak-256 (DNI+email).\nSin FK a Votante ni PII en texto plano (Ley 25.326)."
    note for MerkleTree "VOTAR-334: raíz determinística Keccak-256.\nProofs calculadas on-demand; NO persistidas por votante."
    note for MerkleProof "Calculada on-demand; NO persistida (Ley 25.326).\nVOTAR-354: el votante autenticado solicita la proof para\nacreditar pertenencia al padrón antes de sufragar."
    note for AlmacenRaizMerkle "US-335: contrato MerkleRootStore en Sepolia.\nEvento RootPublished; raíz consultable on-chain."
    note for ContratoBoleta "VOTAR-339: BallotContract.castVote valida\nMerkleProof contra raíz anclada.\nRevierte InvalidMerkleProof si falla.\nVOTAR-379: voterLeaf en calldata/evento es riesgo residual sin ZK."
    note for PadronElectoral "US-331: importación tolerante con novedades.\nUS-335: publicarSelloOnChain() ancla la raíz en blockchain."
    note for Votante "US-312: autenticación institucional.\nVOTAR-354: solicitarProofPadron() sin vincular identidad al voto.\nVOTAR-379: sin tabla off-chain votante↔contenido de voto."

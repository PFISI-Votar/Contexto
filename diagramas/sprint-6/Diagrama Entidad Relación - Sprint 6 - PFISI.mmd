    %% ═══════════════════════════════════════════════════════════════════════
    %% ALMACENAMIENTO DE IMÁGENES ELECTORALES (VOTAR-466)
    %% Reemplaza el disco local del contenedor (/uploads): la fila de dominio
    %% (candidato.foto_url, lista.logo_url, configuracion_sistema.logo_url)
    %% persistía en el volumen de Postgres pero el archivo referenciado vivía
    %% en el filesystem efímero de `back` y se perdía al recrear el
    %% contenedor. Los bytes ahora heredan el mismo volumen que el resto del
    %% estado.
    %% SIN FK desde CANDIDATO / LISTA / CONFIGURACION_SISTEMA: el vínculo es
    %% por URL en varchar (`/imagenes/{id_imagen}`), no por clave foránea.
    %% Decisión consciente para acotar el blast radius del cambio (no había
    %% que tocar los servicios ni los DTOs de esas tres entidades); el costo
    %% es la posibilidad de filas huérfanas si un borrado falla a mitad de
    %% camino — el mismo riesgo que ya existía con archivos huérfanos en
    %% disco, así que no se agrava.
    %% ═══════════════════════════════════════════════════════════════════════

    IMAGEN_ELECTORAL {
        uuid id_imagen PK "Identificador de la imagen (referenciado por URL, no por FK)"
        string tipo "candidato-foto | lista-logo | logo-institucional"
        string mime_type "Siempre image/webp: el contenido se optimiza al guardar"
        bytea contenido "Bytes de la imagen, ya normalizados (resize + WebP + presupuesto de tamaño)"
        int tamano_bytes "Peso del contenido, usado para verificar el presupuesto por tipo"
        string checksum_sha256 "Hex de 64 chars; funciona como ETag HTTP e idempotencia de seed"
        int ancho "Ancho final en píxeles"
        int alto "Alto final en píxeles"
        datetime fecha_creacion "Timestamp de carga"
    }


        boolean permitir_voto_multiple "Habilita re-voto (último voto cuenta)"
        int max_votos_por_votante "Cantidad máxima de votos permitidos (1..N)"
        int min_intervalo_segundos "Tiempo mínimo entre re-votos"
        boolean mostrar_resultados_tiempo_real "Muestra resultados parciales en vivo"
        int duracion_minutos "Duración total del comicio en minutos"
        string[] metodos_autenticacion "GOOGLE | SSO_INSTITUCIONAL — mín. 1 activo (US-316)"
        string politica_revoto "LAST_VOTE_WINS | DISABLED"

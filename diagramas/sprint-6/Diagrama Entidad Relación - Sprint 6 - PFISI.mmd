    ELECCION {
        int id_eleccion PK "Identificador único de la elección"
        string nombre "Nombre descriptivo del comicio (sanitizado en alta)"
        string descripcion "Descripción del proceso electoral"
        datetime fecha_inicio "Fecha y hora de apertura del comicio (UTC, futura)"
        datetime fecha_fin "Fecha y hora de cierre del comicio (UTC, futura > inicio)"
        string estado "BORRADOR | CONFIGURADA | ABIERTA | CERRADA | ESCRUTADA | ARCHIVADA (VOTAR-322)"
        string tipo_votacion "POR_CANDIDATO | POR_LISTA | MIXTO — modalidad electoral (US-316)"
        boolean pausada "VOTAR-347: eje ortogonal a estado — urna pausada por incidente"
        datetime pausada_en "Timestamp de la última pausa de emergencia"
        datetime apertura_real_en "Snapshot apertura efectiva (VOTAR-374 Acta de Apertura)"
        string apertura_modo "MANUAL | AUTOMATICO"
        string apertura_actor_nombre "Responsable humano de la apertura (nullable si automático)"

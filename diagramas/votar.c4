specification {
  // ─────────────────────────
  // Tipos de Elementos
  // ─────────────────────────
  element actor {
    notation "Persona"
    style { shape person; color primary }
  }
  
  element system {
    notation "Sistema de Software"
    style { shape rectangle; color primary }
  }
  
  element externalSystem {
    notation "Sistema Externo"
    style { shape rectangle; color muted }
  }
  
  element frontend {
    notation "Contenedor: Web SPA"
    style { shape browser; color blue }
  }
  
  element backend {
    notation "Contenedor: API REST"
    style { shape component; color blue }
  }
  
  element database {
    notation "Contenedor: Base de Datos"
    style { shape storage; color blue }
  }
  
  element smartcontract {
    notation "Contenedor: Smart Contracts"
    style { shape component; color indigo; border dashed }
  }

  // Nueva distinción: librería OZ vs contrato propio
  element ozlibrary {
    notation "Librería OpenZeppelin"
    style { shape component; color green; border dashed }
  }
  
  element component {
    notation "Componente de Software"
    style { shape component; color secondary }
  }

  // ─────────────────────────
  // Etiquetas para Semántica
  // ─────────────────────────
  tag web3
  tag offchain
  tag e2e
  tag openzeppelin
  tag security
}

model {
  // ─────────────────────────
  // Actores
  // ─────────────────────────
  votante = actor "Votante" {
    description "Ciudadano empadronado con derecho a sufragio"
  }
  
  autoridad = actor "Autoridad Electoral" {
    description "Administrador responsable del ciclo de vida del comicio"
  }
  
  auditor = actor "Auditor" {
    description "Observador público interesado en la integridad del escrutinio"
  }

  // ─────────────────────────
  // Sistemas Externos
  // ─────────────────────────
  sso = externalSystem "SSO Institucional" {
    technology "OAuth 2.0 / OpenID Connect"
    description "Proveedor de identidad de la institución (Ej. CEUTI / UTN FRVM)"
  }
  
  rpc = externalSystem "Proveedor de Nodos RPC" {
    #web3
    technology "Infura / Alchemy"
    description "Gateway HTTP/WebSocket para interactuar con la cadena de bloques"
  }
  
  ethereum = externalSystem "Red Ethereum" {
    #web3
    technology "Sepolia Testnet / EVM"
    description "Blockchain pública para el registro inmutable y descentralizado de sufragios"
  }

  // ─────────────────────────
  // Sistema Principal y Contenedores
  // ─────────────────────────
  votar = system "Plataforma VOTAR" {
    description "Ecosistema de votación descentralizada garantizando anonimato y verificabilidad E2E"

    // Capa Frontend
    bud = frontend "Boleta Única Digital (BUD)" {
      #e2e
      technology "React.js / Ethers.js"
      description "Interfaz para selección de candidatos, generación de claves ECC y firma de transacciones"

      auth = component "Módulo de Autenticación BUD" {
        technology "React Context / OIDC"
        description "Gestiona el inicio de sesión y obtención del token SSO para el votante"
      }
      ballot = component "Selector de Candidatos" {
        technology "React Component"
        description "Interfaz para la selección de boletas y candidatos"
      }
      cryptoEngine = component "Generador Criptográfico" {
        technology "Web Crypto API"
        description "Genera claves efímeras ECC, firma sufragios y calcula nulificadores en el cliente"
      }
      proofRequester = component "Manejador de Pruebas" {
        technology "Fetch API"
        description "Solicita el Merkle Proof correspondiente al API Backend"
      }
      blockchainClient = component "Cliente Blockchain BUD" {
        technology "Ethers.js"
        description "Construye la transacción Web3, adjunta la firma y la envía al nodo RPC"
      }
    }
    
    panel = frontend "Panel de Administración" {
      technology "React.js"
      description "Interfaz para la gestión institucional del padrón y reglas electorales"

      adminAuth = component "Módulo de Autenticación Admin" {
        technology "React Context / OIDC"
        description "Valida privilegios de autoridad electoral con SSO"
      }
      voterManager = component "Cargador de Padrón" {
        technology "React / PapaParse"
        description "Permite cargar, validar y procesar la lista de votantes habilitados"
      }
      electionConfig = component "Configurador de Comicios" {
        technology "React Component"
        description "Define candidatos, fechas y parámetros electorales"
      }
      revoteConfigurator = component "Configurador de Voto Múltiple" {
        technology "React Form / Zod"
        description "Panel para autoridad: habilita/inhabilita re-voto, define maxVotesPerVoter (1..N), minIntervalSeconds entre re-votos y política de cómputo (último voto cuenta). Valida coherencia y previsualiza impacto antes de guardar"
      }
      rootPublisher = component "Publicador de Raíz Merkle" {
        technology "Ethers.js"
        description "Permite a la autoridad publicar la Merkle Root calculada on-chain antes de apertura del comicio"
      }
    }
    
    dashboard = frontend "Dashboard Público" {
      technology "React.js / Ethers.js"
      description "Plataforma de auditoría ciudadana y visualización de resultados en tiempo real"

      statsViewer = component "Visualizador de Resultados" {
        technology "React / Chart.js"
        description "Presenta estadísticas de participación y gráficos de escrutinio en tiempo real"
      }
      blockScanner = component "Escáner Blockchain" {
        technology "Ethers.js"
        description "Monitorea directamente los logs y eventos emitidos por los Smart Contracts"
      }
      localVerifier = component "Verificador de Voto" {
        technology "React / Merkle-Lib"
        description "Permite al ciudadano verificar de manera offline/online que su voto fue computado"
      }
    }

    // Capa Backend Tradicional
    api = backend "API Backend" {
      #offchain
      technology "Node.js (Express) / Python (FastAPI)"
      description "Motor off-chain de desvinculación de identidad, construcción de Árboles de Merkle, validación de reglas electorales y orquestación del ciclo de vida del comicio (Ley 25.326 PII nunca toca on-chain)"

      apiRouter = component "Controlador de Rutas API" {
        technology "Express / FastAPI / OpenAPI 3.1"
        description "Expone endpoints REST versionados para BUD, Panel y Dashboard. Rate limiting + CORS"
      }
      jwtValidator = component "Validador JWT / OIDC" {
        technology "Passport.js / python-jose"
        description "Valida tokens SSO (OAuth 2.0 / OIDC), verifica firma con JWKS y extrae claims de rol (votante / ELECTION_ADMIN / auditor)"
      }
      rulesEngine = component "Motor de Reglas Electorales" {
        technology "TypeScript / Pydantic"
        description "Valida reglas de negocio antes de oficializar: mínimo de candidatos, voto en blanco habilitado, ventanas temporales, bajas/sucesiones bloqueadas tras inicio, y política de voto múltiple (revoteEnabled, maxVotesPerVoter ≥1, minIntervalSeconds ≥0, coherencia con ventana del comicio)"
      }
      revotePolicyService = component "Servicio de Política de Re-voto" {
        technology "Node.js Service"
        description "Materializa la política configurada por la autoridad: persiste {revoteEnabled, maxVotesPerVoter, minIntervalSeconds, tallyPolicy=LAST_WINS}, sincroniza parámetros con el deployment del BallotContract vía ElectionFactory y expone consulta al BUD para UI/feedback (intentos restantes, próximo reintento)"
      }
      lifecycleManager = component "Gestor de Ciclo de Vida Electoral" {
        technology "Node.js Service"
        description "Crea, abre, cierra (manual/automático) y archiva comicios. Coordina publicación de Merkle Root on-chain previa a apertura y disparo de eventos de cierre"
      }
      voterCsvProcessor = component "Procesador de Padrón" {
        technology "PapaParse / Pandas + Joi"
        description "Parsea CSV, normaliza identidades, deduplica, calcula hash de cada votante (sin almacenar PII en claro) y entrega listado al merkleBuilder"
      }
      identityDecoupler = component "Servicio de Desvinculación de Identidad" {
        technology "Node.js Crypto / cryptography (Py)"
        description "Garantiza separación criptográfica identidad→voto: emite credencial anónima vinculada a la hoja Merkle del votante autenticado; no persiste la asociación (compliance Ley 25.326)"
      }
      merkleBuilder = component "Constructor de Árboles de Merkle" {
        technology "merkletreejs / py-merkle"
        description "Construye el Merkle Tree por elección (hash keccak256), calcula la raíz para publicación on-chain y genera Merkle Proofs individuales bajo demanda autenticada"
      }
      reportGenerator = component "Generador de Reportes Institucionales" {
        technology "Node.js / ReportLab"
        description "Emite documentación oficial: acta de apertura/cierre, padrón firmado, reporte de participación. Consume eventos on-chain + datos relacionales"
      }
      auditLogger = component "Registro de Auditoría (Audit Log)" {
        technology "Winston / structlog + append-only"
        description "Registra toda acción crítica (login admin, carga padrón, publicación raíz, apertura/cierre). Inmutable a nivel aplicación; expone consulta de auditoría"
      }
      dataAccess = component "Acceso a Datos (DAO)" {
        technology "Prisma / SQLAlchemy"
        description "Gestiona consultas y escrituras a la Base de Datos Relacional con transacciones ACID"
      }
    }

    db = database "Base de Datos Relacional" {
      #offchain
      technology "PostgreSQL 16"
      description "Persistencia de configuración institucional, padrón hasheado y bitácora de auditoría. NO almacena votos ni vínculo identidad→sufragio"

      electionSchema = component "Esquema de Comicios" {
        technology "PostgreSQL Schema"
        description "Comicios, ventanas temporales, parámetros, direcciones de contratos desplegados, Merkle Roots publicadas y política de voto múltiple (revote_enabled BOOL, max_votes_per_voter INT, min_interval_seconds INT, tally_policy ENUM)"
      }
      candidateSchema = component "Esquema de Categorías y Listas" {
        technology "PostgreSQL Schema"
        description "Categorías electorales (ej. Presidente, Vocales), agrupaciones/listas y candidatos asociados"
      }
      voterSchema = component "Esquema de Padrón" {
        technology "PostgreSQL Schema"
        description "Hashes del padrón habilitado por elección, vinculados a la hoja Merkle correspondiente"
      }
      auditLogSchema = component "Esquema de Audit Log" {
        technology "PostgreSQL Schema (append-only)"
        description "Bitácora inmutable de operaciones administrativas y técnicas para auditoría normativa"
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // Capa Descentralizada — Ecosistema On-Chain (reworked)
    // ─────────────────────────────────────────────────────────────────
    contracts = smartcontract "Ecosistema On-Chain" {
      #web3
      technology "Solidity ^0.8.24 / OpenZeppelin v5 / Ethereum Sepolia"
      description "Contratos inteligentes que implementan la lógica electoral inmutable: validación de padrón vía Merkle, verificación de Firma Digital (Ley 25.506), unicidad del voto con regla ‘último voto cuenta’, escrutinio público y auditoría on-chain"

      // ── Patrón Factory ──────────────────────────────────────────────
      // Estándar (Uniswap V2/V3, Aragon) para instanciar contratos hijos
      // sin acoplamiento directo entre autoridad y contratos de elección.
      electionFactory = component "ElectionFactory.sol" {
        #web3
        technology "Solidity / UUPS Proxy Factory"
        description "Despliega y registra instancias de BallotContract + VoteRegistry + TallyContract + AuditView por comicio. Recibe struct RevoteConfig{bool enabled; uint16 maxVotesPerVoter; uint32 minIntervalSeconds; TallyPolicy policy} en createElection() e inmutabiliza la política tras apertura. Solo ELECTION_ADMIN_ROLE. Emite ElectionCreated(electionId, ballot, tally, revoteConfig)"
      }

      // ── Contrato de Votación Principal ──────────────────────────────
      // Separado para cumplir responsabilidad única.
      // Patrón CEI + ReentrancyGuard + Pausable.
      ballotContract = component "BallotContract.sol" {
        #web3
        technology "Solidity / UUPSUpgradeable"
        description "Orquesta castVote(): valida ventana temporal, Merkle Proof (padrón), firma ECDSA (Ley 25.506) y política de voto múltiple. Aplica modifiers: enforceRevoteLimits(nullifier) → revert si !revoteEnabled && voteCount[nullifier]>0; revert si voteCount[nullifier] >= maxVotesPerVoter; revert si block.timestamp - lastVoteTs[nullifier] < minIntervalSeconds (custom errors: RevoteDisabled, MaxVotesReached, RetryTooSoon(remainingSeconds)). Delega al VoteRegistry y notifica al TallyContract. Soporta candidateId reservados BLANCO/NULO. Patrón CEI + ReentrancyGuard"
      }

      // ── Registro de Votos (estado canónico de sufragios) ────────────
      // Reemplaza al simple NullifierRegistry para soportar la regla de
      // negocio "Unicidad del voto": un votante puede re-emitir; solo
      // cuenta el último voto registrado antes del cierre.
      voteRegistry = component "VoteRegistry.sol" {
        #web3 #security
        technology "Solidity Smart Contract"
        description "Mapping(electionId => mapping(bytes32 nullifier => VoterState{candidateId, voteCount uint16, lastVoteTs uint64, txHash})). Permite sobrescritura mientras la elección esté abierta según RevoteConfig: incrementa voteCount, actualiza lastVoteTs y candidateId (tallyPolicy=LAST_WINS). Tras cierre inmutable. Solo BALLOT_ROLE escribe. View pública getVoterState(nullifier) → expone intentos restantes y próximo retry. Emite VoteCast(electionId, nullifier, candidateId, voteCount, isOverwrite)"
      }

      // ── Contador / Escrutinio ───────────────────────────────────────
      // Contadores incrementales con compensación (decrementar viejo,
      // incrementar nuevo) para soportar re-voto en O(1) sin recorrer
      // el VoteRegistry completo.
      tallyContract = component "TallyContract.sol" {
        #web3
        technology "Solidity Smart Contract"
        description "Mantiene mapping(electionId => mapping(candidateId => uint256)) con contadores actualizados por delta en cada castVote (incluye contadores reservados para blanco y nulo). Expone resultados parciales/finales vía view functions consumidas por Dashboard"
      }

      // ── Contrato de Verificación y Auditoría Pública ────────────────
      // Capa view/pure desacoplada del estado mutable, según Scope:
      // "Smart Contract de Verificación y Auditoría Pública".
      auditViewContract = component "AuditViewContract.sol" {
        #web3
        technology "Solidity Smart Contract (view/pure)"
        description "Funciones de solo lectura para auditores externos: verifyReceipt(txHash), getElectionState(id), getTurnout(id), getMerkleRootUsed(id), getRevoteConfig(id), getRevoteStats(id) → (totalRevotes, uniqueVoters, overwriteRatio). No muta estado; permite recálculo independiente del escrutinio (Verificabilidad Universal)"
      }

      // ── Almacenamiento de Merkle Roots ───────────────────────────────
      merkleRootStore = component "MerkleRootStore.sol" {
        #web3
        technology "Solidity Smart Contract"
        description "Almacena y versiona Merkle Roots publicadas por la autoridad (MERKLE_UPDATER_ROLE). Mapping: electionId => bytes32 root + timestamp. Inmutable tras apertura del comicio. Emite RootPublished(electionId, root)"
      }

      // ── Librería OZ: MerkleProof ─────────────────────────────────────
      ozMerkleProof = ozlibrary "OZ: MerkleProof.sol" {
        #openzeppelin
        technology "OpenZeppelin v5 / Solidity Library"
        description "Verifica criptográficamente la pertenencia de una hoja al árbol vía MerkleProof.verify(proof, root, leaf). No se deploya por separado"
      }

      // ── Librería OZ: ECDSA ───────────────────────────────────────────
      // Verificación de Firma Digital del votante on-chain
      // (cumplimiento Ley 25.506 + presunción de autoría).
      ozECDSA = ozlibrary "OZ: ECDSA.sol" {
        #openzeppelin #security
        technology "OpenZeppelin v5 / Solidity Library"
        description "Recupera y valida la dirección firmante del payload del voto (ECDSA.recover sobre EIP-191/EIP-712). Sustento técnico de la Firma Digital exigida por Ley 25.506"
      }

      // ── Librería OZ: AccessControl ───────────────────────────────────
      ozAccessControl = ozlibrary "OZ: AccessControl.sol" {
        #openzeppelin #security
        technology "OpenZeppelin v5 / Solidity Library"
        description "RBAC: ELECTION_ADMIN_ROLE (autoridad), PAUSER_ROLE (emergencia), MERKLE_UPDATER_ROLE (publicación raíz), BALLOT_ROLE (escritura en VoteRegistry/Tally). Hereda AccessControlDefaultAdminRules"
      }

      // ── Librería OZ: Pausable ────────────────────────────────────────
      ozPausable = ozlibrary "OZ: Pausable.sol" {
        #openzeppelin #security
        technology "OpenZeppelin v5 / Solidity Library"
        description "Circuit Breaker. Modifier whenNotPaused sobre castVote(). Solo PAUSER_ROLE pausa/reanuda ante incidentes de seguridad"
      }
    }
  }

  // ─────────────────────────
  // Relaciones
  // ─────────────────────────
  
  // Actores -> Frontends
  votante -> votar.bud.auth "Se autentica para iniciar sesión" { technology "HTTPS" }
  votante -> votar.bud.ballot "Selecciona candidatos y emite voto" { technology "UI" }
  autoridad -> votar.panel.adminAuth "Se autentica como administrador" { technology "HTTPS" }
  autoridad -> votar.panel.voterManager "Carga y valida el padrón de votantes" { technology "HTTPS" }
  autoridad -> votar.panel.electionConfig "Configura parámetros y comicios" { technology "HTTPS" }
  autoridad -> votar.panel.revoteConfigurator "Define política de voto múltiple (habilitación, máx intentos, intervalo)" { technology "HTTPS" }
  autoridad -> votar.panel.rootPublisher "Publica Merkle Root on-chain antes de abrir comicio" { technology "HTTPS / Web3" }
  auditor -> votar.dashboard.statsViewer "Visualiza estadísticas de participación" { technology "HTTPS" }
  auditor -> votar.dashboard.localVerifier "Verifica integridad del sufragio de forma local" { technology "HTTPS" }

  // Flujo interno BUD
  votar.bud.auth -> votar.bud.proofRequester "Provee identidad validada para solicitar Merkle Proof"
  votar.bud.ballot -> votar.bud.cryptoEngine "Envía selección para firmar y procesar"
  votar.bud.cryptoEngine -> votar.bud.blockchainClient "Entrega voto firmado, nulificador y parámetros"
  votar.bud.proofRequester -> votar.bud.blockchainClient "Entrega Merkle Proof para la transacción"

  // Frontends -> API Backend
  votar.bud.proofRequester -> votar.api.apiRouter "Solicita Merkle Proof autenticado" { technology "JSON/HTTPS" }
  votar.panel.voterManager -> votar.api.apiRouter "Envía CSV de padrón para procesamiento" { technology "multipart/HTTPS" }
  votar.panel.electionConfig -> votar.api.apiRouter "Envía configuración del comicio" { technology "JSON/HTTPS" }
  votar.panel.revoteConfigurator -> votar.api.apiRouter "Envía RevoteConfig para validación y persistencia" { technology "JSON/HTTPS" }
  votar.bud.ballot -> votar.api.apiRouter "Consulta intentos restantes y próximo retry permitido" { technology "JSON/HTTPS" }
  votar.dashboard.statsViewer -> votar.api.apiRouter "Consulta reportes institucionales y metadatos off-chain" { technology "JSON/HTTPS" }

  // Flujo interno API Backend
  votar.api.apiRouter -> votar.api.jwtValidator "Valida JWT en cada request"
  votar.api.jwtValidator -> sso "Obtiene JWKS y valida claims OIDC" { technology "HTTPS" }
  votar.api.apiRouter -> votar.api.rulesEngine "Valida reglas electorales antes de oficializar"
  votar.api.apiRouter -> votar.api.revotePolicyService "Persiste/consulta política de voto múltiple"
  votar.api.revotePolicyService -> votar.api.rulesEngine "Valida coherencia de RevoteConfig"
  votar.api.revotePolicyService -> votar.api.dataAccess "Persiste config en electionSchema"
  votar.api.revotePolicyService -> votar.api.lifecycleManager "Inyecta RevoteConfig en createElection() de la factory"
  votar.api.revotePolicyService -> rpc "Consulta getVoterState(nullifier) para feedback al BUD" { technology "JSON-RPC/HTTPS" }
  votar.api.apiRouter -> votar.api.lifecycleManager "Solicita apertura/cierre del comicio"
  votar.api.apiRouter -> votar.api.voterCsvProcessor "Procesa padrón cargado por la autoridad"
  votar.api.apiRouter -> votar.api.identityDecoupler "Solicita credencial anónima desvinculada"
  votar.api.apiRouter -> votar.api.merkleBuilder "Obtiene Merkle Proof del votante autenticado"
  votar.api.apiRouter -> votar.api.reportGenerator "Genera reportes oficiales bajo demanda"
  votar.api.apiRouter -> votar.api.dataAccess "Lee/escribe entidades operativas"

  votar.api.voterCsvProcessor -> votar.api.merkleBuilder "Entrega hojas hasheadas para construcción del árbol"
  votar.api.merkleBuilder -> votar.api.dataAccess "Persiste raíz y hojas del padrón"
  votar.api.identityDecoupler -> votar.api.merkleBuilder "Solicita hoja Merkle del votante validado"
  votar.api.rulesEngine -> votar.api.dataAccess "Consulta configuración y candidatos"
  votar.api.lifecycleManager -> votar.api.dataAccess "Actualiza estado del comicio"
  votar.api.lifecycleManager -> votar.api.auditLogger "Registra apertura/cierre"
  votar.api.reportGenerator -> votar.api.dataAccess "Lee datos relacionales"
  votar.api.reportGenerator -> rpc "Consulta resultados/eventos on-chain" { technology "JSON-RPC/HTTPS" }
  votar.api.apiRouter -> votar.api.auditLogger "Registra acciones críticas"

  // API Backend -> Base de Datos
  votar.api.dataAccess -> votar.db.electionSchema "Lee/escribe comicios y direcciones de contrato" { technology "TCP/IP" }
  votar.api.dataAccess -> votar.db.candidateSchema "Lee/escribe categorías, listas y candidatos" { technology "TCP/IP" }
  votar.api.dataAccess -> votar.db.voterSchema "Lee/escribe hashes de padrón" { technology "TCP/IP" }
  votar.api.dataAccess -> votar.db.auditLogSchema "Append-only de bitácora" { technology "TCP/IP" }

  // Panel Admin -> Blockchain (publicación de raíz)
  votar.panel.rootPublisher -> rpc "Publica Merkle Root calculada vía tx firmada por autoridad" { technology "JSON-RPC/HTTPS" }

  // Frontends -> Blockchain (Web3)
  votar.bud.blockchainClient -> rpc "Envía transacción de voto anónimo firmado (Payload + Proof)" { technology "JSON-RPC/HTTPS" }
  votar.dashboard.blockScanner -> rpc "Consulta logs, eventos y estado del contrato" { technology "JSON-RPC/HTTPS" }
  votar.dashboard.localVerifier -> votar.dashboard.blockScanner "Valida prueba contra raíz on-chain"

  // RPC -> Smart Contracts
  rpc -> votar.contracts.electionFactory "Proxy para createElection() (ELECTION_ADMIN_ROLE)"
  rpc -> votar.contracts.ballotContract "Proxy para castVote() y lecturas de estado"
  rpc -> votar.contracts.merkleRootStore "Proxy para publishRoot() (MERKLE_UPDATER_ROLE)"
  rpc -> votar.contracts.tallyContract "Lecturas view del escrutinio para Dashboard"
  rpc -> votar.contracts.auditViewContract "Lecturas pure/view para auditores externos"

  // Flujo interno On-Chain
  votar.contracts.electionFactory -> votar.contracts.ballotContract "Despliega BallotContract por comicio"
  votar.contracts.electionFactory -> votar.contracts.voteRegistry "Despliega VoteRegistry asociado"
  votar.contracts.electionFactory -> votar.contracts.tallyContract "Despliega TallyContract asociado"
  votar.contracts.electionFactory -> votar.contracts.auditViewContract "Despliega AuditView asociado"
  votar.contracts.electionFactory -> votar.contracts.ozAccessControl "Configura roles iniciales en deployment"

  votar.contracts.ballotContract -> votar.contracts.merkleRootStore "Consulta Merkle Root activa en castVote()"
  votar.contracts.ballotContract -> votar.contracts.ozMerkleProof "MerkleProof.verify(proof, root, leaf): valida padrón"
  votar.contracts.ballotContract -> votar.contracts.ozECDSA "ECDSA.recover(payload, sig): verifica Firma Digital (Ley 25.506)"
  votar.contracts.ballotContract -> votar.contracts.voteRegistry "Lee voteCount/lastVoteTs, valida RevoteConfig y registra/sobrescribe voto (LAST_WINS)"
  votar.contracts.ballotContract -> votar.contracts.tallyContract "Actualiza contadores por delta (incl. blanco/nulo)"
  votar.contracts.ballotContract -> votar.contracts.ozPausable "whenNotPaused modifier en castVote()"
  votar.contracts.ballotContract -> votar.contracts.ozAccessControl "onlyRole(PAUSER_ROLE) en pause()/unpause()"
  votar.contracts.ballotContract -> ethereum "Emite VoteCast(electionId, nullifier, candidateId, isOverwrite)"

  votar.contracts.voteRegistry -> votar.contracts.ozAccessControl "onlyRole(BALLOT_ROLE): solo BallotContract escribe"
  votar.contracts.tallyContract -> votar.contracts.ozAccessControl "onlyRole(BALLOT_ROLE) para mutar contadores"
  votar.contracts.merkleRootStore -> votar.contracts.ozAccessControl "onlyRole(MERKLE_UPDATER_ROLE)"
  votar.contracts.auditViewContract -> votar.contracts.voteRegistry "Lee estado de votos (view)"
  votar.contracts.auditViewContract -> votar.contracts.tallyContract "Lee contadores (view)"
  votar.contracts.auditViewContract -> votar.contracts.merkleRootStore "Lee raíz utilizada (view)"
}

views {
  // ─────────────────────────
  // Vistas Arquitectónicas
  // ─────────────────────────

  view context_view {
    title "Diagrama de Contexto (Nivel 1) - Plataforma VOTAR"
    description "Visión macroscópica de los actores involucrados y las dependencias externas del sistema."
    
    include votante, autoridad, auditor
    include votar
    include sso, rpc, ethereum

    autoLayout TopBottom
  }

  view container_view of votar {
    title "Diagrama de Contenedores (Nivel 2) - Plataforma VOTAR"
    description "Despliegue interno de la Plataforma VOTAR mostrando la separación entre lógica off-chain y web3."
    
    include *
    
    style votar.contracts { color indigo }
    style rpc, ethereum { color gray }
    
    autoLayout LeftRight
  }

  // ─────────────────────────
  // Vistas de Componentes (Nivel 3)
  // ─────────────────────────

  view bud_components of votar.bud {
    title "Diagrama de Componentes (Nivel 3) - Boleta Única Digital (BUD)"
    description "Componentes internos del frontend de votación y firma criptográfica."
    
    include *
    include votante
    include votar.api
    include rpc
    
    autoLayout TopBottom
  }

  view   api_components of votar.api {
    title "Diagrama de Componentes (Nivel 3) - API Backend"
    description "Lógica de control, validación, anonimato y construcción del árbol de Merkle."
    
    include *
    include sso
    include votar.bud
    include votar.panel
    include votar.db
    
    autoLayout LeftRight
  }

  view panel_components of votar.panel {
    title "Diagrama de Componentes (Nivel 3) - Panel de Administración"
    description "Interfaz de administración electoral incluyendo la publicación de Merkle Root on-chain."
    
    include *
    include autoridad
    include votar.api
    include rpc
    
    autoLayout TopBottom
  }

  view  contracts_components of votar.contracts {
    title "Diagrama de Componentes (Nivel 3) - Ecosistema On-Chain"
    description "Contratos inteligentes propios (indigo) y librerías OpenZeppelin v5 (verde) del ecosistema electoral."
    
    include *
    include rpc
    include ethereum

    style votar.contracts.ozMerkleProof { color green }
    style votar.contracts.ozAccessControl { color green }
    style votar.contracts.ozPausable { color green }
    style votar.contracts.ozECDSA { color green }

    autoLayout TopBottom
  }

  // Vista dinámica del flujo de sufragio
  dynamic view sufragio_flow {
    title "Flujo de Emisión de Sufragio con Desvinculación de Identidad (Componentes)"
    description "Incluye paso 0: publicación de Merkle Root on-chain por la autoridad antes de apertura del comicio."

    // Fase previa: publicación de padrón on-chain
    autoridad -> votar.panel.rootPublisher "0a. Solicita publicación de Merkle Root calculada"
    votar.panel.rootPublisher -> rpc "0b. Envía tx firmada con MERKLE_UPDATER_ROLE"
    rpc -> votar.contracts.merkleRootStore "0c. Almacena root: electionId => bytes32"

    // Fase de votación
    votante -> votar.bud.auth "1. Inicia sesión contra SSO"
    votar.bud.auth -> votar.api.apiRouter "2. Solicita token y validación"
    votar.api.jwtValidator -> sso "3. Valida credenciales de identidad"
    sso -> votar.api.jwtValidator "4. Retorna claims de identidad legal"
    votar.api.identityDecoupler -> votar.api.merkleBuilder "5. Genera credencial anónima y calcula Merkle Proof off-chain"
    votar.api.apiRouter -> votar.bud.proofRequester "6. Entrega Merkle Proof del votante"
    votar.bud.cryptoEngine -> votar.bud.blockchainClient "7. Firma sufragio (ECDSA) y calcula nulificador localmente"
    votar.bud.blockchainClient -> rpc "8. Envía castVote(payload, sig, proof) a la red"
    rpc -> votar.contracts.ballotContract "9. Transmite transacción castVote() a la EVM"
    votar.contracts.ballotContract -> votar.contracts.merkleRootStore "10. Consulta Merkle Root activa del comicio"
    votar.contracts.ballotContract -> votar.contracts.ozMerkleProof "11. MerkleProof.verify(proof, root, leaf): valida padrón"
    votar.contracts.ballotContract -> votar.contracts.ozECDSA "12. ECDSA.recover: verifica Firma Digital del votante (Ley 25.506)"
    votar.contracts.ballotContract -> votar.contracts.voteRegistry "13. Registra/sobrescribe voto por nullifier (último voto cuenta)"
    votar.contracts.ballotContract -> votar.contracts.tallyContract "14. Actualiza contadores por delta"
    votar.contracts.ballotContract -> ethereum "15. Emite VoteCast(electionId, nullifier, candidateId, isOverwrite)"
  }
}